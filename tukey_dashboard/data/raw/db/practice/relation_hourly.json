{"meta": {"period": "practice", "t0_utc": "2026-11-14 12:09:00", "t1_utc": "2026-11-15 09:00:00", "extracted_at_utc": "2026-11-15 11:06:20"}, "sql": "\nSELECT h, sb, relation, count() AS impressions, countIf(pur = pid) AS purchases\nFROM (\n  SELECT s.h AS h, s.sb AS sb, s.pid AS pid, s.pur AS pur,\n         multiIf(arrayExists(x -> x < s.rts, e.buys), 'bought_before',\n                 arrayExists(x -> x < s.rts, e.carts), 'carted_not_bought', 'other') AS relation\n  FROM (\n    SELECT toUnixTimestamp(toStartOfHour(r.rts)) AS h, f.sb AS sb, r.uid AS uid, r.rts AS rts, f.pur AS pur, pid\n    FROM (SELECT request_id::String AS rid, ts::DateTime64(3) AS fts, served_by::String AS sb, fallback_reason::String AS fr,\n       clicked::String AS clk, purchased::String AS pur, revenue_eur::Float64 AS rev, latency_ms::Nullable(Float64) AS lat,\n       shown::Array(String) AS shown_items\nFROM team_37.feedback WHERE request_id::String != '__init__') AS f\n    INNER JOIN (SELECT request_id::String AS rid, user_id::String AS uid, ts::DateTime64(3) AS rts FROM shop.requests WHERE ts::DateTime64(3) >= '2026-11-14 12:09:00' AND ts::DateTime64(3) < '2026-11-15 09:00:00') AS r ON r.rid = f.rid\n    ARRAY JOIN f.shown_items AS pid\n  ) AS s\n  LEFT JOIN (\n    SELECT u, p, groupArrayIf(t, et = 'purchase') AS buys, groupArrayIf(t, et = 'add_to_cart') AS carts\n    FROM (\n      SELECT user_id::String AS u, product_id::String AS p, ts::DateTime64(3) AS t, event_type::String AS et FROM shop.history_events\n      WHERE event_type::String IN ('purchase', 'add_to_cart') AND user_id::String IN (SELECT user_id::String FROM shop.requests WHERE ts::DateTime64(3) >= '2026-11-14 12:09:00' AND ts::DateTime64(3) < '2026-11-15 09:00:00')\n      UNION ALL\n      SELECT user_id::String AS u, product_id::String AS p, ts::DateTime64(3) AS t, event_type::String AS et FROM shop.events\n      WHERE event_type::String IN ('purchase', 'add_to_cart') AND ts::DateTime64(3) < '2026-11-15 09:00:00'\n        AND user_id::String IN (SELECT user_id::String FROM shop.requests WHERE ts::DateTime64(3) >= '2026-11-14 12:09:00' AND ts::DateTime64(3) < '2026-11-15 09:00:00')\n    ) GROUP BY u, p\n  ) AS e ON e.u = s.uid AND e.p = s.pid\n)\nGROUP BY h, sb, relation ORDER BY h, sb, relation SETTINGS max_execution_time = 28", "err": null, "secs": 0.7, "rows": [{"h": 1794657600, "sb": "fallback", "relation": "bought_before", "impressions": 1841, "purchases": 0}, {"h": 1794657600, "sb": "fallback", "relation": "carted_not_bought", "impressions": 892, "purchases": 5}, {"h": 1794657600, "sb": "fallback", "relation": "other", "impressions": 30787, "purchases": 30}, {"h": 1794657600, "sb": "team", "relation": "bought_before", "impressions": 3154, "purchases": 0}, {"h": 1794657600, "sb": "team", "relation": "carted_not_bought", "impressions": 1562, "purchases": 12}, {"h": 1794657600, "sb": "team", "relation": "other", "impressions": 52944, "purchases": 35}, {"h": 1794661200, "sb": "fallback", "relation": "bought_before", "impressions": 662, "purchases": 0}, {"h": 1794661200, "sb": "fallback", "relation": "carted_not_bought", "impressions": 339, "purchases": 1}, {"h": 1794661200, "sb": "fallback", "relation": "other", "impressions": 9969, "purchases": 2}, {"h": 1794661200, "sb": "team", "relation": "bought_before", "impressions": 9858, "purchases": 0}, {"h": 1794661200, "sb": "team", "relation": "carted_not_bought", "impressions": 2590, "purchases": 15}, {"h": 1794661200, "sb": "team", "relation": "other", "impressions": 84582, "purchases": 59}, {"h": 1794664800, "sb": "fallback", "relation": "bought_before", "impressions": 1154, "purchases": 0}, {"h": 1794664800, "sb": "fallback", "relation": "carted_not_bought", "impressions": 508, "purchases": 5}, {"h": 1794664800, "sb": "fallback", "relation": "other", "impressions": 18578, "purchases": 13}, {"h": 1794664800, "sb": "team", "relation": "bought_before", "impressions": 5911, "purchases": 1}, {"h": 1794664800, "sb": "team", "relation": "carte