{"meta": {"period": "practice", "t0_utc": "2026-11-14 12:09:00", "t1_utc": "2026-11-15 08:40:42", "extracted_at_utc": "2026-11-15 08:40:42"}, "sql": "\nWITH (SELECT groupArray(product_id::String) FROM shop.catalog_updates WHERE change::String = 'new_product') AS newp\nSELECT sb, slot, relation, count() AS impressions, countIf(clk = pid) AS clicks, countIf(pur = pid) AS purchases\nFROM (\n  SELECT s.sb AS sb, s.slot AS slot, s.pid AS pid, s.clk AS clk, s.pur AS pur,\n         multiIf(arrayExists(x -> x < s.rts, e.buys), 'bought_before',\n                 arrayExists(x -> x < s.rts, e.carts), 'carted_not_bought',\n                 length(s.rv) = 0, 'no_session_views',\n                 s.pid = s.rv[length(s.rv)], 'session_last_view',\n                 has(s.rv, s.pid), 'session_earlier_view',\n                 has(newp, s.pid), 'new_product_other', 'other') AS relation\n  FROM (\n    SELECT f.sb AS sb, r.uid AS uid, r.rts AS rts, r.rv AS rv, f.clk AS clk, f.pur AS pur, pid, slot\n    FROM (SELECT request_id::String AS rid, ts::DateTime64(3) AS fts, served_by::String AS sb, fallback_reason::String AS fr,\n       clicked::String AS clk, purchased::String AS pur, revenue_eur::Float64 AS rev, latency_ms::Nullable(Float64) AS lat,\n       shown::Array(String) AS shown_items\nFROM team_37.feedback WHERE request_id::String != '__init__') AS f\n    INNER JOIN (SELECT request_id::String AS rid, user_id::String AS uid, ts::DateTime64(3) AS rts,\n                       arrayMap(x -> x.1, arraySort(x -> x.2, JSONExtract(toJSONString(__raw_data), 'recent_views', 'Array(Tuple(product_id String, ts String))'))) AS rv FROM shop.requests WHERE ts::DateTime64(3) >= '2026-11-14 12:09:00' AND ts::DateTime64(3) < '2026-11-15 08:40:42') AS r ON r.rid = f.rid\n    ARRAY JOIN f.shown_items AS pid, arrayEnumerate(f.shown_items) AS slot\n  ) AS s\n  LEFT JOIN (\n    SELECT u, p, groupArrayIf(t, et = 'purchase') AS buys, groupArrayIf(t, et = 'add_to_cart') AS carts\n    FROM (\n      SELECT user_id::String AS u, product_id::String AS p, ts::DateTime64(3) AS t, event_type::String AS et FROM shop.history_events\n      WHERE event_type::String IN ('purchase', 'add_to_cart') AND user_id::String IN (SELECT user_id::String FROM shop.requests WHERE ts::DateTime64(3) >= '2026-11-14 12:09:00' AND ts::DateTime64(3) < '2026-11-15 08:40:42')\n      UNION ALL\n      SELECT user_id::String AS u, product_id::String AS p, ts::DateTime64(3) AS t, event_type::String AS et FROM shop.events\n      WHERE event_type::String IN ('purchase', 'add_to_cart') AND ts::DateTime64(3) < '2026-11-15 08:40:42'\n        AND user_id::String IN (SELECT user_id::String FROM shop.requests WHERE ts::DateTime64(3) >= '2026-11-14 12:09:00' AND ts::DateTime64(3) < '2026-11-15 08:40:42')\n    ) GROUP BY u, p\n  ) AS e ON e.u = s.uid AND e.p = s.pid\n)\nGROUP BY sb, slot, relation ORDER BY sb, relation, slot SETTINGS max_execution_time = 28", "err": null, "secs": 2.6, "rows": [{"sb": "fallback", "slot": 1, "relation": "bought_before", "impressions": 2384, "clicks": 3, "purchases": 1}, {"sb": "fallback", "slot": 2, "relation": "bought_before", "impressions": 1883, "clicks": 1, "purchases": 0}, {"sb": "fallback", "slot": 3, "relation": "bought_before", "impressions": 2096, "clicks": 0, "purchases": 0}, {"sb": "fallback", "slot": 4, "relation": "bought_before", "impressions": 1838, "clicks": 0, "purchases": 0}, {"sb": "fallback", "slot": 5, "relation": "bought_before", "impressions": 1519, "clicks": 0, "purchases": 0}, {"sb": "fallback", "slot": 6, "relation": "bought_before", "impressions": 1363, "clicks": 1, "purchases": 0}, {"sb": "fallback", "slot": 7, "relation": "bought_before", "impressions": 1335, "clicks": 0, "purchases": 0}, {"sb": "fallback", "slot": 8, "relation": "bought_before", "impressions": 1338, "clicks": 2, "purchases": 1}, {"sb": "fallback", "slot": 9, "relation": "bought_before", "impressions": 1316, "clicks": 1, "purchases": 1}, {"sb": "fallback", "slot": 10, "relation": "bought_