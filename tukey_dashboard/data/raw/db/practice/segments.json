{"meta": {"period": "practice", "t0_utc": "2026-11-14 12:09:00", "t1_utc": "2026-11-15 08:40:42", "extracted_at_utc": "2026-11-15 08:40:42"}, "sql": "\nSELECT dim, val, sb, count() AS requests, countIf(clk != '') AS clicks, countIf(pur != '') AS purchases, round(sum(rev), 2) AS revenue\nFROM (\n  SELECT r.page, r.device, r.nu, r.cold, r.nviews, f.sb, f.clk, f.pur, f.rev\n  FROM (SELECT request_id::String AS rid, context.page::String AS page, context.device::String AS device, is_new_user::Bool AS nu,\n               JSONExtract(toJSONString(__raw_data), 'recent_views', 'Array(Tuple(product_id String, ts String))').product_id AS rv, length(rv) AS nviews, nu OR hasAny(rv, (SELECT groupArray(product_id::String) FROM shop.catalog_updates WHERE change::String = 'new_product')) AS cold FROM shop.requests WHERE ts::DateTime64(3) >= '2026-11-14 12:09:00' AND ts::DateTime64(3) < '2026-11-15 08:40:42') AS r\n  INNER JOIN (SELECT request_id::String AS rid, ts::DateTime64(3) AS fts, served_by::String AS sb, fallback_reason::String AS fr,\n       clicked::String AS clk, purchased::String AS pur, revenue_eur::Float64 AS rev, latency_ms::Nullable(Float64) AS lat,\n       shown::Array(String) AS shown_items\nFROM team_37.feedback WHERE request_id::String != '__init__') AS f ON f.rid = r.rid\n) ARRAY JOIN ['page', 'device', 'new_user', 'cold', 'n_views', 'page_x_new_user'] AS dim,\n             [page, device, toString(nu), toString(cold), multiIf(nviews = 0, '0', nviews = 1, '1', nviews <= 3, '2-3', '4+'), concat(page, '|new=', toString(nu))] AS val\nGROUP BY dim, val, sb ORDER BY dim, val, sb SETTINGS max_execution_time = 28", "err": null, "secs": 1.9, "rows": [{"dim": "cold", "val": "false", "sb": "fallback", "requests": 18414, "clicks": 278, "purchases": 71, "revenue": 1500.29}, {"dim": "cold", "val": "false", "sb": "team", "requests": 116588, "clicks": 6117, "purchases": 1674, "revenue": 86568.26}, {"dim": "cold", "val": "true", "sb": "fallback", "requests": 10926, "clicks": 307,